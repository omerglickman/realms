{
  "name": "realms-kings-and-other-stuff",
  "version": "0.0.1",
  "private": true,
  "description": "Realms, Kings and Other Stuff — a medieval-ish hex grand strategy game",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "postbuild": "node -e \"const fs=require('fs');fs.renameSync('dist/index.html','dist/realms.html');console.log('-> dist/realms.html')\"",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "sim": "tsx src/headless/run.ts"
  },
  "dependencies": {
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^5.1.0"
  }
}
